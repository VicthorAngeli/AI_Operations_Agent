APP_ENV=production
APP_DEBUG=false

# Fill this value locally or in the deployment secret manager.
OPENAI_API_KEY=replace_with_real_openai_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

DATABASE_URL=sqlite:///./runtime/ai_operations_agent.db
API_BASE_URL=http://localhost:8000
API_ALLOWED_ORIGINS=https://your-frontend.example.com
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60